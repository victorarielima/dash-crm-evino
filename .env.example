# ============================================================
# IACRM Dashboard — variáveis de ambiente
# Copie para .env (local) e configure as mesmas em Project Settings
# > Environment Variables na Vercel. NUNCA comite .env.
# ============================================================

# Chave geral da Insider (InOne > Settings > API Authentication Tokens).
# Cobre Email, SMS e Architect (WhatsApp).
INSIDER_API_KEY=

# Overrides por canal (só se sua conta emitir tokens específicos):
INSIDER_EMAIL_AUTH_KEY=
INSIDER_SMS_AUTH_KEY=
INSIDER_ARCHITECT_TOKEN=

# Web Push — token próprio (Authorization: Bearer + partner_id string).
INSIDER_WEBPUSH_API_KEY=
INSIDER_WEBPUSH_PARTNER_ID=10014458

# App Push — token do projeto MOBILE (diferente da de analytics). Só dia atual.
INSIDER_MOBILE_API_KEY=
INSIDER_PARTNER_NAME=evino

# ---------- Redshift (Data Warehouse) ----------
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=

# ---------- Auth / SSO Google (NextAuth) ----------
# AUTH_SECRET: gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=
# OAuth Client (Google Cloud Console > Credentials > OAuth client ID > Web):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local apenas. Em produção/Vercel, deixe vazio ou defina a URL pública do site.
AUTH_URL=http://localhost:3000
